<?xml version="1.0"?>
<robot name="six_joint_robot">

  <!-- ================= ARM PLANNING GROUP ================= -->

  <group name="arm">
    <chain base_link="shoulder_link" tip_link="wrist_3_link"/>
  </group>

  <!-- ================= ARM HOME POSITION ================= -->

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="0.0"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_1_joint" value="0.0"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>

  <!-- ================= DISABLE ADJACENT COLLISIONS ================= -->

  <disable_collisions
      link1="shoulder_link"
      link2="upper_arm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="upper_arm_link"
      link2="forearm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="forearm_link"
      link2="wrist_1_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_1_link"
      link2="wrist_2_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_2_link"
      link2="wrist_3_link"
      reason="Adjacent"/>

</robot>
