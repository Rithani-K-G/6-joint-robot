<?xml version="1.0"?>
<robot name="six_joint_robot">

  <!-- ================= ARM PLANNING GROUP ================= -->

  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- ================= GRIPPER PLANNING GROUP ================= -->

  <group name="gripper">
    <joint name="gripper_1_joint"/>
    <joint name="gripper_2_joint"/>
  </group>

  <!-- ================= END EFFECTOR ================= -->

  <end_effector
      name="gripper_eef"
      parent_link="wrist_link"
      group="gripper"
      parent_group="arm"/>

  <!-- ================= ARM HOME POSITION ================= -->

  <group_state name="home" group="arm">
    <joint name="base_joint" value="0.0"/>
    <joint name="shoulder_joint" value="0.0"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_joint" value="0.0"/>
  </group_state>

  <!-- ================= GRIPPER POSITIONS ================= -->

  <!-- Both fingers closed -->

  <group_state name="closed" group="gripper">
    <joint name="gripper_1_joint" value="0.0"/>
    <joint name="gripper_2_joint" value="0.0"/>
  </group_state>

  <!-- Both fingers open: 20 mm -->

  <group_state name="open" group="gripper">
    <joint name="gripper_1_joint" value="0.020"/>
    <joint name="gripper_2_joint" value="0.020"/>
  </group_state>

  <!-- ================= DISABLE ADJACENT COLLISIONS ================= -->

  <disable_collisions
      link1="base_link"
      link2="shoulder_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="shoulder_link"
      link2="upper_arm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="upper_arm_link"
      link2="forearm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="forearm_link"
      link2="wrist_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_link"
      link2="tool0"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_link"
      link2="gripper_1_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_link"
      link2="gripper_2_link"
      reason="Adjacent"/>

</robot>
