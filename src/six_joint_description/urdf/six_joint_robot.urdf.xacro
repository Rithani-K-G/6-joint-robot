<?xml version="1.0"?>
<!-- Generated from the CAD model. Preserve CAD-derived origins, axes, masses and inertias. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_joint_robot">

  <xacro:arg name="controllers_file" default=""/>

  <!-- Zero pose: arm extended horizontally along +X.
       REP-103: +X forward, +Y left, +Z up. base_link is fixed to the table.
       Meshes are expressed in their own link frames and use millimetres (scale 0.001).
       Detailed visual meshes are paired with simplified box collision geometry. -->

  <material name="gray"><color rgba="0.55 0.55 0.58 1.0"/></material>
  <material name="dark_blue"><color rgba="0.30 0.30 0.75 1.0"/></material>
  <material name="blue"><color rgba="0.20 0.45 0.80 1.0"/></material>
  <material name="green"><color rgba="0.20 0.65 0.40 1.0"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.15 1.0"/></material>
  <material name="red"><color rgba="0.85 0.20 0.20 1.0"/></material>

  <!-- world: link vazio que segura a base (o braço é fixado na mesa). O KDL
       não aceita inércia no link raiz, e o MoveIt2 precisa de um frame fixo. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Base link ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://six_joint_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="-0.01875 0 0.003" rpy="0 0 0"/>
      <geometry><box size="0.1365 0.153904 0.008"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.012 0 0.0225" rpy="0 0 0"/>
      <geometry><box size="0.0485 0.0405 0.035"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.012 0 0.02935" rpy="0 0 0"/>
      <geometry><box size="0.0485 0.0305 0.0447"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.009115 0.000204 0.019000" rpy="0 0 0"/>
      <mass value="0.163529"/>
      <inertia ixx="1.05389732e-04" ixy="3.36721098e-07" ixz="1.32190372e-05" iyy="1.22373715e-04" iyz="-2.72612884e-07" izz="1.59760563e-04"/>
    </inertial>
  </link>

  <!-- ===================== Shoulder link ===================== -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://six_joint_description/meshes/shoulder_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="-0.0205 0 0.02825" rpy="0 0 0"/>
      <geometry><box size="0.0715 0.0305 0.0585"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.012 0.00235 0.04225" rpy="0 0 0"/>
      <geometry><box size="0.0485 0.0447 0.0305"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.023308 0.001280 0.032799" rpy="0 0 0"/>
      <mass value="0.146220"/>
      <inertia ixx="5.17310159e-05" ixy="-3.32454185e-06" ixz="-2.27066681e-06" iyy="8.97761574e-05" iyz="-1.76275354e-06" izz="6.22354889e-05"/>
    </inertial>
  </link>

  <!-- ===================== Upper arm link ===================== -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://six_joint_description/meshes/upper_arm_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.02775 0.021 0" rpy="0 0 0"/>
      <geometry><box size="0.086 0.006 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.02775 -0.021 0" rpy="0 0 0"/>
      <geometry><box size="0.086 0.006 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.02125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0095 0.04 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.06225 0 0" rpy="0 0 0"/>
      <geometry><box size="0.017 0.04 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.093 0.00235 0" rpy="0 0 0"/>
      <geometry><box size="0.0485 0.0447 0.0305"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.067687 0.001286 -0.000229" rpy="0 0 0"/>
      <mass value="0.145509"/>
      <inertia ixx="3.49445009e-05" ixy="-5.94484335e-06" ixz="6.04589824e-07" iyy="1.54922917e-04" iyz="-3.73676032e-08" izz="1.71239124e-04"/>
    </inertial>
  </link>

  <!-- ===================== Forearm link ===================== -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://six_joint_description/meshes/forearm_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.02025 0.021 0" rpy="0 0 0"/>
      <geometry><box size="0.071 0.006 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.02025 -0.021 0" rpy="0 0 0"/>
      <geometry><box size="0.071 0.006 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.02125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.0095 0.04 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.04725 0 0" rpy="0 0 0"/>
      <geometry><box size="0.017 0.04 0.0305"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.078 0.00235 0" rpy="0 0 0"/>
      <geometry><box size="0.0485 0.0447 0.0305"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.053964 0.001193 -0.000213" rpy="0 0 0"/>
      <mass value="0.124269"/>
      <inertia ixx="3.00560734e-05" ixy="-4.52300481e-06" ixz="4.45460597e-07" iyy="9.97806231e-05" iyz="-2.71767370e-08" izz="1.13955943e-04"/>
    </inertial>
  </link>

  <!-- ===================== Wrist link ===================== -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://six_joint_description/meshes/wrist_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.016375 0.018625 -0.009375" rpy="0 0 0"/>
      <geometry><box size="0.06325 0.01075 0.04925"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.016375 -0.018625 -0.009375" rpy="0 0 0"/>
      <geometry><box size="0.06325 0.01075 0.04925"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.03935 0 -0.012" rpy="0 0 0"/>
      <geometry><box size="0.0447 0.0305 0.0485"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0526 0.007038 0.021625" rpy="0 0 0"/>
      <geometry><box size="0.0292 0.077925 0.02275"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0466 -0.007038 -0.032875" rpy="0 0 0"/>
      <geometry><box size="0.0412 0.077925 0.01375"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.041975 0.041865"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.038535 -0.000205 -0.011007" rpy="0 0 0"/>
      <mass value="0.129153"/>
      <inertia ixx="6.09036574e-05" ixy="-3.62067470e-08" ixz="-1.29674768e-06" iyy="7.06973307e-05" iyz="-1.93013849e-06" izz="5.84227981e-05"/>
    </inertial>
  </link>



  <!-- Base joint: rotation about Z. Limits and effort/velocity values are retained from the source CAD URDF. -->
  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="4.1" velocity="4.817"/>
  </joint>

  <!-- Shoulder joint: positive rotation raises the arm. -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.04225" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.94247" upper="1.57079" effort="4.1" velocity="4.817"/>
  </joint>

  <!-- Elbow joint: positive rotation raises the forearm. -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.105 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57079" upper="1.57079" effort="4.1" velocity="4.817"/>
  </joint>

  <!-- Wrist joint: positive rotation raises the wrist. -->
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.09 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57079" upper="1.57079" effort="1.9" velocity="7.330"/>
  </joint>

  <!-- Garra: pinhão m2 z18 (R = 18 mm) no XC430-W240-T. Cada mordente anda
       0 a 20 mm (0 = fechada); effort = stall / (2 R) = 52.8 N,
       velocity = ω·R. O de baixo copia o de cima (mimic): no robô real é o mesmo
       pinhão, então só junta_garra é comandada. -->



  <!-- ===================== Gripper finger links ===================== -->
  <!--
    The two STL files are retained in their CAD-exported local coordinates.
    Their initial CAD positions are mirrored about the XZ plane. The joint
    origins are therefore at the wrist-link frame origin and the prismatic
    axes move the fingers in opposite Y directions.

    IMPORTANT: The finger masses/inertias below are provisional simulation
    values because the supplied CAD Xacro did not include gripper inertials.
    Replace them with mass properties exported from CAD before hardware use.
  -->
  <link name="gripper_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://six_joint_description/meshes/gripper_1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://six_joint_description/meshes/gripper_1_colisao.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0757 -0.0062 -0.0112" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1.0e-5" ixy="0" ixz="0"
               iyy="1.0e-5" iyz="0" izz="1.0e-5"/>
    </inertial>
  </link>

  <link name="gripper_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://six_joint_description/meshes/gripper_2.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://six_joint_description/meshes/gripper_2_colisao.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0757 0.0062 0.0112" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1.0e-5" ixy="0" ixz="0"
               iyy="1.0e-5" iyz="0" izz="1.0e-5"/>
    </inertial>
  </link>

  <!-- Gripper finger 1 slides outward along +Y. 0 = CAD closed position. -->
  <joint name="gripper_1_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="gripper_1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.020" effort="52.8" velocity="0.05"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Gripper finger 2 slides outward along -Y. 0 = CAD closed position. -->
  <joint name="gripper_2_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="gripper_2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.020" effort="52.8" velocity="0.05"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Tool centre point frame, positioned at the end of the wrist link. -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0.0835 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ROS 2 Control: four revolute arm joints + two prismatic gripper joints -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Harmonic ROS 2 Control integration -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
