<?xml version="1.0"?>
<robot name="six_joint_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
       Six-joint arm rebuilt from the CAD housings (visual meshes + simple cylinder collision).

       The STL files share one CAD world frame in the assembled pose.
       That assembled CAD pose is q = 0 (same approach as the 5-joint robot).
       Every joint frame sits on a measured joint axis, so each mesh visual
       origin is just the inverse of its link frame: the meshes line up
       exactly at q = 0.

       Positive joint direction: joints 2-4 raise the arm, joint 1 turns
       it anticlockwise seen from above.
       ========================================================= -->

  <!-- file:// prefix: RViz cannot load a bare absolute path (Gazebo can) -->
  <xacro:arg name="mesh_dir" default="file://$(find six_joint_description)/meshes"/>
  <xacro:arg name="controllers_file" default=""/>

  <material name="base_dark"><color rgba="0.20 0.23 0.26 1.0"/></material>
  <material name="joint_bluegrey"><color rgba="0.34 0.42 0.47 1.0"/></material>
  <material name="arm_lightgrey"><color rgba="0.68 0.70 0.72 1.0"/></material>
  <material name="flange_metal"><color rgba="0.48 0.51 0.54 1.0"/></material>

  <!-- Simple collision: one cylinder per CAD part, fitted to the mesh (cylinder axis = local z). -->
  <xacro:macro name="cyl_collision" params="xyz rpy radius length">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <cylinder radius="${radius}" length="${length}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- Full-resolution CAD mesh, visual only. -->
  <xacro:macro name="cad_mesh" params="file xyz rpy mat">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <mesh filename="${file}" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="${mat}"/>
    </visual>
  </xacro:macro>

  <!-- Placeholder inertia. COM is the centre of the link's meshes. -->
  <xacro:macro name="approx_inertial" params="mass inertia xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${inertia}" ixy="0" ixz="0" iyy="${inertia}" iyz="0" izz="${inertia}"/>
    </inertial>
  </xacro:macro>

  <!-- World anchor -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_base.stl"
      xyz="0.000000000 0.000000000 0.000000000"
      rpy="0.000000000 0.000000000 0.000000000"
      mat="base_dark"/>
    <xacro:cyl_collision xyz="0.000002500 0.000000000 0.033000000"
      rpy="0.000000000 0.000000000 1.570796327"
      radius="0.1300" length="0.0660"/>
    <xacro:approx_inertial mass="8.0" inertia="0.1" xyz="0.000002500 0.000000000 0.033000000"/>
  </link>

  <link name="shoulder_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j1.stl"
      xyz="0.000000000 0.000000000 -0.089200000"
      rpy="0.000000000 0.000000000 0.000000000"
      mat="joint_bluegrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j2.stl"
      xyz="0.000000000 0.000000000 -0.089200000"
      rpy="0.000000000 0.000000000 0.000000000"
      mat="joint_bluegrey"/>
    <xacro:cyl_collision xyz="0.000000245 -0.000001545 -0.011200000"
      rpy="0.000000000 0.000000000 1.570796327"
      radius="0.0784" length="0.0600"/>
    <xacro:cyl_collision xyz="0.000000055 0.000000025 -0.000041750"
      rpy="-2.003225054 1.570796327 0.000000000"
      radius="0.0742" length="0.1506"/>
    <xacro:approx_inertial mass="3.0" inertia="0.05" xyz="0.000000055 0.000000025 -0.000041750"/>
  </link>

  <link name="upper_arm_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_link2.stl"
      xyz="0.000000000 0.089200000 0.000000000"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="arm_lightgrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j3.stl"
      xyz="0.000000000 0.089200000 0.000000000"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="joint_bluegrey"/>
    <xacro:cyl_collision xyz="-0.121885550 -0.174028773 -0.000475532"
      rpy="1.576653480 -1.056246630 -0.615602829"
      radius="0.0502" length="0.4531"/>
    <xacro:cyl_collision xyz="-0.243768682 -0.348098900 -0.000951573"
      rpy="0.000000000 0.000000000 1.570796327"
      radius="0.0607" length="0.1285"/>
    <xacro:approx_inertial mass="8.0" inertia="0.08" xyz="-0.142988062 -0.184195745 -0.008171065"/>
  </link>

  <link name="forearm_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_link3.stl"
      xyz="0.244178236 0.437700000 0.000958718"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="arm_lightgrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j4.stl"
      xyz="0.244178236 0.437700000 0.000958718"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="joint_bluegrey"/>
    <xacro:cyl_collision xyz="-0.183885523 0.067479542 -0.000713775"
      rpy="1.575373360 0.634101818 -1.917119359"
      radius="0.0420" length="0.4203"/>
    <xacro:cyl_collision xyz="-0.368181643 0.134558650 -0.001431705"
      rpy="0.000000000 0.000000000 1.570796327"
      radius="0.0495" length="0.0964"/>
    <xacro:approx_inertial mass="6.0" inertia="0.06" xyz="-0.202202594 0.069991750 -0.003395359"/>
  </link>

  <link name="wrist_1_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_link4.stl"
      xyz="0.613040258 0.302500000 0.002410709"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="arm_lightgrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j5.stl"
      xyz="0.613040258 0.302500000 0.002410709"
      rpy="1.570796327 0.432428727 0.000000000"
      mat="joint_bluegrey"/>
    <xacro:cyl_collision xyz="0.000891838 -0.000642130 -0.054554281"
      rpy="-0.002780339 0.000577553 1.571062904"
      radius="0.0381" length="0.1372"/>
    <xacro:cyl_collision xyz="0.001106594 -0.000641600 -0.109129338"
      rpy="-1.570796327 0.000000000 -1.570796327"
      radius="0.0450" length="0.0863"/>
    <xacro:approx_inertial mass="2.0" inertia="0.02" xyz="0.002567792 -0.000641600 -0.071863660"/>
  </link>

  <link name="wrist_2_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_link5.stl"
      xyz="-0.304200000 -0.111058548 0.611973936"
      rpy="1.570796327 -1.138367599 1.570796327"
      mat="arm_lightgrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_link6.stl"
      xyz="-0.304200000 -0.111058548 0.611973936"
      rpy="1.570796327 -1.138367599 1.570796327"
      mat="arm_lightgrey"/>
    <xacro:cad_mesh file="$(arg mesh_dir)/part_j6.stl"
      xyz="-0.304200000 -0.111058548 0.611973936"
      rpy="1.570796327 -1.138367599 1.570796327"
      mat="joint_bluegrey"/>
    <xacro:cyl_collision xyz="-0.001057792 0.000667434 -0.047284388"
      rpy="3.137665641 0.000070017 -3.141560336"
      radius="0.0350" length="0.1227"/>
    <xacro:cyl_collision xyz="-0.042207800 0.000851884 -0.094609613"
      rpy="-1.570848444 -0.432428725 -1.570693437"
      radius="0.0320" length="0.1103"/>
    <xacro:cyl_collision xyz="-0.001057800 0.000850295 -0.094608879"
      rpy="-1.570796327 -0.432428727 -1.570796327"
      radius="0.0381" length="0.0600"/>
    <xacro:approx_inertial mass="1.5" inertia="0.015" xyz="-0.031708200 -0.001353939 -0.052189453"/>
  </link>

  <link name="wrist_3_link">
    <xacro:cad_mesh file="$(arg mesh_dir)/part_flange.stl"
      xyz="0.706743971 0.112362627 -0.303100000"
      rpy="0.000000000 0.000000000 -0.432428727"
      mat="flange_metal"/>
    <xacro:cyl_collision xyz="0.000160299 0.000453243 -0.089257800"
      rpy="0.000000000 0.000000000 1.138367599"
      radius="0.0340" length="0.0140"/>
    <xacro:approx_inertial mass="1.0" inertia="0.01" xyz="0.000160299 0.000453243 -0.089257800"/>
  </link>


  <!-- =====================================================
      GRIPPER - VISUAL ONLY, FIXED TO JOINT 6
      ===================================================== -->

  <link name="gripper_base_link">

    <!-- Physical properties -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0" ixz="0"
        iyy="0.0001" iyz="0"
        izz="0.0001"/>
    </inertial>

    <!-- Actual gripper CAD model -->
    <visual>
      <origin xyz="0.594644 0.397721 -0.263842"
            rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://six_joint_description/meshes/part_gripper.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>

    <!-- Simplified collision geometry -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06330 0.07491 0.08600"/>
      </geometry>
    </collision>

  </link>


  <!-- Attach gripper to the sixth robot link -->
  <joint name="gripper_fixed_joint" type="fixed">

    <parent link="wrist_3_link"/>
    <child link="gripper_base_link"/>

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </joint>


  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.000000000 0.000000000 0.089200000" rpy="0.000000000 0.000000000 0.000000000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="150" velocity="3.14"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0.000000000 0.000000000 0.000000000" rpy="-1.570796327 0.000000000 0.432428727"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="150" velocity="3.14"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.244178236 -0.348500000 -0.000958718" rpy="0.000000000 0.000000000 0.000000000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="150" velocity="3.14"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.368862023 0.135200000 -0.001451991" rpy="0.000000000 0.000000000 0.000000000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="60" velocity="3.14"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0.001066322 -0.001700000 -0.108647839" rpy="-1.570796327 0.000000000 -1.570796327"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="60" velocity="3.14"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="-0.001100000 0.001304079 -0.094770034" rpy="-3.141592654 -1.570796327 0.000000000"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="60" velocity="3.14"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool0_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0.000125723 0.000272385 -0.096300000" rpy="3.141592654 0.000000000 0.000000000"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>